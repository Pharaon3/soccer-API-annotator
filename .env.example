# Copy to .env and change values before running in production.

# Required for POST /api/annotate (header: X-API-Key)
API_KEY=change-me-api-key

# SHA-256 hex of your app password:
# python -c "import hashlib; print(hashlib.sha256(b'your-password').hexdigest())"
APP_PASSWORD_HASH=change-me-sha256-hex

# Long random string (32+ characters) for session signing
SESSION_SECRET=change-me-long-random-secret

# Set to production to enable strict startup checks
# ANNOTATOR_ENV=production

# Optional
# HOST=0.0.0.0
# PORT=8080
# COOKIE_SECURE=true
# LOG_LEVEL=INFO
# ANNOTATOR_RELOAD=true
