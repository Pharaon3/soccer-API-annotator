# Copy to .env and change values before running in production.

# Required for POST /large_model_processing (header: X-API-Key)
API_KEY=change-me-api-key

# Long random string (32+ characters) for session signing
SESSION_SECRET=change-me-long-random-secret

# Five static annotator accounts (set ID + password or password hash per user)
ANNOTATOR_USER_1_ID=annotator1
ANNOTATOR_USER_1_PASSWORD=change-me-1

ANNOTATOR_USER_2_ID=annotator2
ANNOTATOR_USER_2_PASSWORD=change-me-2

ANNOTATOR_USER_3_ID=annotator3
ANNOTATOR_USER_3_PASSWORD=change-me-3

ANNOTATOR_USER_4_ID=annotator4
ANNOTATOR_USER_4_PASSWORD=change-me-4

ANNOTATOR_USER_5_ID=annotator5
ANNOTATOR_USER_5_PASSWORD=change-me-5

# Optional: store SHA-256 hex instead of plain password
# python -c "import hashlib; print(hashlib.sha256(b'your-password').hexdigest())"
# ANNOTATOR_USER_1_PASSWORD_HASH=...

# Set to production to enable strict startup checks
# ANNOTATOR_ENV=production

# Optional: seconds until next API call is expected after each request (default 3600)
# API_CALL_INTERVAL_SEC=3600

# Optional: minutes before an idle annotator is marked offline (default 15)
# PRESENCE_IDLE_MINUTES=120

# Optional: per-request annotation window (seconds).
# Each API call uses a random value in [min, max] for annotator deadline/countdown.
# ANNOTATE_DURATION_MIN_SEC=25
# ANNOTATE_DURATION_MAX_SEC=26

# Optional: per-label event lead offsets in frames.
# Positive values store that label earlier than the current frame.
# Example: LABEL_FRAME_OFFSET_PASS=5 records pass at current frame - 5.
# Available labels: pass, pass_received, take_on, recovery, tackle,
# aerial_duel, save, shot, foul, goal, interception, substitution,
# clearance, block, ball_out_of_play.
# LABEL_FRAME_OFFSET_PASS=5

#LABEL_FRAME_OFFSET_PASS=5
#LABEL_FRAME_OFFSET_FOUL=10
#LABEL_FRAME_OFFSET_GOAL=10

# Optional: snap annotator labels to event frame candidates within this many frames (default 5).
# EVENT_CANDIDATE_SNAP_RANGE_FRAMES=5

# Optional: response delay when no annotators are available and random labels are returned
# RANDOM_FALLBACK_RESPONSE_DELAY_SEC=26

# Optional
# HOST=0.0.0.0
# PORT=8080
# COOKIE_SECURE=true
# LOG_LEVEL=INFO
# ANNOTATOR_RELOAD=true
